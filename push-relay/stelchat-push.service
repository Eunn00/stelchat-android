[Unit]
Description=StelChat Android FCM relay
After=network-online.target
Wants=network-online.target

[Service]
User=stelchat-push
Group=stelchat-push
WorkingDirectory=/opt/stelchat-push
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/stelchat-push/service-account.json
Environment=PUSH_STATE_DB=/var/lib/stelchat-push/state.sqlite
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stelchat-push/venv/bin/python /opt/stelchat-push/relay.py
Restart=always
RestartSec=10
StateDirectory=stelchat-push
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryHigh=80M
MemoryMax=120M
CPUQuota=15%
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
